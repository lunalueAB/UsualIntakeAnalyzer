<Window x:Class="UsualIntakeAnalyzer.Views.SourceManageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자료원 관리" Height="600" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 헤더 -->
            <RowDefinition Height="Auto"/>   <!-- 추가 버튼 -->
            <RowDefinition Height="*"/>       <!-- 트리 -->
            <RowDefinition Height="Auto"/>   <!-- 액션 -->
            <RowDefinition Height="Auto"/>   <!-- 닫기 -->
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="자료원 관리"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="대분류(사업) → 기수 → 차수 추가/편집/삭제"
                       FontSize="11" Foreground="{StaticResource TextDimBrush}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 추가 버튼 줄 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="＋ 사업" Margin="0,0,4,0"
                    FontSize="11" Padding="0,6"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnAddProject_Click"/>
            <Button Grid.Column="1" Content="＋ 기수" Margin="2,0,2,0"
                    FontSize="11" Padding="0,6"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnAddPhase_Click"/>
            <Button Grid.Column="2" Content="＋ 차수" Margin="4,0,0,0"
                    FontSize="11" Padding="0,6"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnAddRound_Click"/>
        </Grid>

        <!-- 트리 -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4">
            <TreeView x:Name="TreeSources"
                      BorderThickness="0" Background="Transparent"
                      Foreground="{StaticResource TextBrush}"/>
        </Border>

        <!-- 액션 줄 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="편집" Width="68" Margin="0,0,6,0"
                    FontSize="11" Padding="0,6"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnEditNode_Click"/>
            <Button Content="삭제" Width="68"
                    FontSize="11" Padding="0,6"
                    Style="{StaticResource DangerButton}"
                    Click="BtnDeleteNode_Click"/>
        </StackPanel>

        <!-- 닫기 -->
        <Border Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="닫기" Width="100" Padding="0,8"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
