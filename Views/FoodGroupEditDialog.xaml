<Window x:Class="UsualIntakeAnalyzer.Views.FoodGroupEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="식품군 추가" Height="640" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 헤더 -->
            <RowDefinition Height="Auto"/>   <!-- 식품군명·설명 -->
            <RowDefinition Height="Auto"/>   <!-- 검색·전체/해제 -->
            <RowDefinition Height="*"/>       <!-- 좌우 식품 패널 -->
            <RowDefinition Height="Auto"/>   <!-- 요약 -->
            <RowDefinition Height="Auto"/>   <!-- 버튼 -->
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitle"
                       Text="식품군 추가"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="식품군 명을 입력하고 국건영 코드의 식품을 선택해 조합을 만듭니다"
                       FontSize="11" Foreground="{StaticResource TextDimBrush}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 식품군명·설명 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="식품군명 *"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecBrush}"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtName"
                     ToolTip="예: 적색육, 잎채소" TextChanged="OnAnyChange"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="설명"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecBrush}"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtDesc"/>
        </Grid>

        <!-- 검색·전체·해제 -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TxtSearch"
                     TextChanged="TxtSearch_TextChanged"
                     ToolTip="식품명·식품군·코드 검색"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                <Button Content="전체" Width="48" FontSize="10" Padding="0,4"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnSelectAll_Click"/>
                <Button Content="해제" Width="48" FontSize="10" Padding="0,4"
                        Margin="3,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnDeselectAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- 좌우 분할: 식품 선택 / 선택된 식품 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 식품 체크리스트 -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,7">
                        <TextBlock Text="국건영 코드 식품 (2일 조사 등장)"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecBrush}"/>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FoodList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ItemBorder"
                                            Padding="10,5,10,5"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="FoodItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="CheckMark"
                                                       Text="✓"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FoodName}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SubInfo}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecBrush}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CodeBadge}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background"
                                                    Value="{StaticResource AccentDimBrush}"/>
                                            <Setter TargetName="CheckMark"  Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 우측: 선택된 식품 -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       x:Name="TxtSelectedHeader"
                                       Text="선택된 식품 (0)" FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="전체 비우기" FontSize="10"
                                    Padding="6,2"
                                    Style="{StaticResource GhostButton}"
                                    Foreground="{StaticResource DangerBrush}"
                                    Click="BtnDeselectAll_Click"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="TxtSelectedEmpty"
                                   Text="좌측에서 식품을 선택하세요"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="20"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SelectedFoodList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="6,4,6,0"
                                                Background="{StaticResource AccentDimBrush}"
                                                BorderBrush="{StaticResource AccentBorderBrush}"
                                                BorderThickness="1" CornerRadius="3"
                                                Padding="8,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FoodName}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CodeBadge}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecBrush}"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="✕" FontSize="11"
                                                        Width="22" Height="22" Padding="0"
                                                        Style="{StaticResource GhostButton}"
                                                        Foreground="{StaticResource TextSecBrush}"
                                                        Tag="{Binding}"
                                                        Click="BtnRemoveSelected_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="TxtSummary"
                   Text="선택 0개"
                   FontSize="11" Foreground="{StaticResource AccentBrush}"
                   Margin="0,8,0,0"/>

        <!-- 버튼 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="취소" Width="92" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="저장" Width="120"
                    IsEnabled="False" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
