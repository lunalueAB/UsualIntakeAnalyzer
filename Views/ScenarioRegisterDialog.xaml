<Window x:Class="UsualIntakeAnalyzer.Views.ScenarioRegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="시나리오 등록" Height="720" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 헤더 -->
            <RowDefinition Height="*"/>       <!-- 본문 (스크롤) -->
            <RowDefinition Height="Auto"/>   <!-- 버튼 -->
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="시나리오 등록"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="식품군 + 사용할 x1·x0 + 등록자를 지정해 한 번에 분석 조건을 저장합니다"
                       FontSize="11" Foreground="{StaticResource TextDimBrush}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 본문 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- ① 식품군명 -->
                <TextBlock Text="① 식품군명 *"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName"
                         ToolTip="예: 적색육, 과일류, 곡류·면류"
                         TextChanged="OnAnyChange"/>

                <!-- ② 식품 선택 -->
                <TextBlock Text="② 식품 선택 (1개 이상) *"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,18,0,4"/>
                <TextBlock Text="등록된 모든 2일 조사 데이터에서 등장한 식품"
                           FontSize="10" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,0,0,6"/>

                <!-- 검색 + 전체/해제 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtFoodSearch"
                             TextChanged="TxtFoodSearch_TextChanged"
                             ToolTip="식품명·식품군·코드 검색"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                        <Button Content="전체" Width="44" FontSize="10" Padding="0,4"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnSelectAll_Click"/>
                        <Button Content="해제" Width="44" FontSize="10" Padding="0,4"
                                Margin="3,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnDeselectAll_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 좌·우 2분할: 식품 선택 / 선택된 식품 -->
                <Grid Height="240">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측: DB 식품 체크리스트 -->
                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,7">
                                <TextBlock x:Name="TxtFoodListHeader"
                                           Text="DB 식품" FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecBrush}"/>
                            </Border>
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="FoodList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ItemBorder"
                                                    Padding="10,5,10,5"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="FoodItem_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" x:Name="CheckMark"
                                                               Text="✓"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               VerticalAlignment="Center"
                                                               Visibility="Collapsed"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FoodName}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SubInfo}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextSecBrush}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding CodeBadge}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextDimBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background"
                                                            Value="{StaticResource AccentDimBrush}"/>
                                                    <Setter TargetName="CheckMark"  Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 우측: 선택된 식품 -->
                    <Border Grid.Column="2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               x:Name="TxtSelectedHeader"
                                               Text="선택된 식품 (0)" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="전체 비우기" FontSize="10"
                                            Padding="6,2"
                                            Style="{StaticResource GhostButton}"
                                            Foreground="{StaticResource DangerBrush}"
                                            Click="BtnDeselectAll_Click"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <!-- 빈 상태 안내 -->
                                <TextBlock x:Name="TxtSelectedEmpty"
                                           Text="좌측 목록에서 식품을 선택하세요"
                                           FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="20"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="SelectedFoodList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="6,4,6,0"
                                                        Background="{StaticResource AccentDimBrush}"
                                                        BorderBrush="{StaticResource AccentBorderBrush}"
                                                        BorderThickness="1" CornerRadius="3"
                                                        Padding="8,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FoodName}"
                                                                       FontSize="12"
                                                                       FontWeight="Medium"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding CodeBadge}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextSecBrush}"
                                                                       Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2"
                                                                Content="✕"
                                                                FontSize="11"
                                                                Width="22" Height="22"
                                                                Padding="0"
                                                                Style="{StaticResource GhostButton}"
                                                                Foreground="{StaticResource TextSecBrush}"
                                                                Tag="{Binding}"
                                                                Click="BtnRemoveSelected_Click"
                                                                ToolTip="선택 해제"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock x:Name="TxtSelectedSummary"
                           Text="선택 0개"
                           FontSize="11" Foreground="{StaticResource AccentBrush}"
                           Margin="0,5,0,0"/>

                <!-- ③ x1 -->
                <TextBlock Text="③ 1일 조사 데이터 (x1) *"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,18,0,4"/>
                <TextBlock Text="선택한 식품 코드가 포함된 1일 조사를 선택"
                           FontSize="10" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="CboX1" SelectionChanged="OnAnyChange"/>

                <!-- ④ x0 -->
                <TextBlock Text="④ 2일 조사 데이터 (x0) *"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,18,0,4"/>
                <TextBlock Text="선택한 식품 코드가 포함된 2일 조사를 선택"
                           FontSize="10" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="CboX0" SelectionChanged="OnAnyChange"/>

                <!-- ⑤ 시뮬 횟수 + 등록자 -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="⑤ 시뮬 횟수"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboSimTime" SelectedValuePath="Content">
                            <ComboBoxItem>1</ComboBoxItem>
                            <ComboBoxItem>3</ComboBoxItem>
                            <ComboBoxItem IsSelected="True">5</ComboBoxItem>
                            <ComboBoxItem>10</ComboBoxItem>
                            <ComboBoxItem>20</ComboBoxItem>
                            <ComboBoxItem>50</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="⑥ 등록자 *"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRegBy" TextChanged="OnAnyChange"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 버튼 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="취소" Width="92" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="저장" Width="120"
                    IsEnabled="False" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
