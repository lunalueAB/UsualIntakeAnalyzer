<Window x:Class="UsualIntakeAnalyzer.Views.FoodPresetManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="산출식품 관리" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 헤더 -->
            <RowDefinition Height="Auto"/>   <!-- 검색 + 추가 버튼 -->
            <RowDefinition Height="*"/>      <!-- 목록 -->
            <RowDefinition Height="Auto"/>   <!-- 상세 -->
            <RowDefinition Height="Auto"/>   <!-- 하단 버튼 -->
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="산출식품 관리"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="0,3,0,0">
                <TextBlock x:Name="TxtContext"
                           Text=""
                           FontSize="11" Foreground="{StaticResource TextDimBrush}"
                           TextWrapping="NoWrap"/>
            </ScrollViewer>
        </StackPanel>

        <!-- 검색 + 추가 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TxtSearch"
                     TextChanged="TxtSearch_TextChanged"
                     ToolTip="이름·설명 검색"/>
            <Button Grid.Column="1" Content="＋ 현재 선택으로 새 산출식품"
                    Margin="8,0,0,0" Padding="12,6"
                    Click="BtnNewFromSelection_Click"
                    ToolTip="현재 분석 탭에서 선택된 식품으로 새 프리셋 등록"/>
            <Button Grid.Column="2" Content="＋ 직접 입력"
                    Margin="8,0,0,0" Padding="12,6"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnNewBlank_Click"/>
        </Grid>

        <!-- 목록 -->
        <DataGrid Grid.Row="2" x:Name="GridPresets"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="GridPresets_SelectionChanged"
                  MouseDoubleClick="GridPresets_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="명칭"      Binding="{Binding Name}"          Width="*"/>
                <DataGridTextColumn Header="식품 수"   Binding="{Binding FoodCount}"     Width="80"/>
                <DataGridTextColumn Header="코드 수"   Binding="{Binding CodeCount}"     Width="80"/>
                <DataGridTextColumn Header="등록"
                    Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Width="100"/>
                <DataGridTextColumn Header="수정"
                    Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd}" Width="100"/>
                <DataGridTextColumn Header="현재 자료 캐시"
                    Binding="{Binding CacheStatus}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 상세 패널 -->
        <Border Grid.Row="3" Margin="0,8,0,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="12,10" MinHeight="80">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TxtDetailName"
                               Text="목록에서 산출식품을 선택하세요."
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="NoWrap"/>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="60" Margin="0,4,0,0">
                    <TextBlock x:Name="TxtDetailFoods"
                               Text=""
                               FontSize="11" Foreground="{StaticResource TextSecBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 하단 버튼 -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 보기/편집/삭제 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="보기"   Width="80" Margin="0,0,6,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnView_Click"/>
                <Button Content="편집"   Width="80" Margin="0,0,6,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnEdit_Click"/>
                <Button Content="삭제"   Width="80"
                        Style="{StaticResource DangerButton}"
                        Click="BtnDelete_Click"/>
            </StackPanel>

            <!-- 우측: 사용/닫기 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="닫기"   Width="92" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnClose_Click"/>
                <Button Content="▶ 사용 (자동 분석)" Width="170"
                        Style="{StaticResource SuccessButton}"
                        Click="BtnUse_Click"
                        ToolTip="선택한 산출식품으로 식품 선택을 복원하고 분석을 실행"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
