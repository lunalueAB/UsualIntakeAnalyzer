<Window x:Class="UsualIntakeAnalyzer.Views.PhaseEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="기수 편집" Height="520" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="소속 사업"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtParent"
                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="기수 번호 *"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtNo"
                 ToolTip="예: 1, 2, 3"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="표시명 *"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtLabel"
                 ToolTip="예: 제1기"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="시작/종료 연도"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <Grid Grid.Row="6" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TxtYearStart" ToolTip="예: 2019"/>
            <TextBlock Grid.Column="1" Text="—" HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextDimBrush}"/>
            <TextBox Grid.Column="2" x:Name="TxtYearEnd"   ToolTip="예: 2021"/>
        </Grid>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="진행 상태"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <ComboBox Grid.Row="8" Grid.Column="1" x:Name="CboStatus">
            <ComboBoxItem Content="완료"/>
            <ComboBoxItem Content="진행중"/>
            <ComboBoxItem Content="예정"/>
            <ComboBoxItem Content="중단"/>
        </ComboBox>

        <TextBlock Grid.Row="10" Grid.Column="0" Text="표본 수"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtSample"/>

        <TextBlock Grid.Row="12" Grid.Column="0" Text="비고"
                   VerticalAlignment="Top" Margin="0,6,0,0"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="12" Grid.Column="1" x:Name="TxtNote"
                 Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>

        <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="86" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click"/>
            <Button Content="저장" Width="86" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
