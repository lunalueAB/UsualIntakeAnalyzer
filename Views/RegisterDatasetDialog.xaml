<Window x:Class="UsualIntakeAnalyzer.Views.RegisterDatasetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자료 등록" Height="310" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 설명 -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- 등록자 / 등록일 -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- 파일 선택 -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- 파일 경로 표시 -->
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>  <!-- 버튼 -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 설명 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="설명"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox   Grid.Row="0" Grid.Column="1"
                   x:Name="TxtDesc"
                   ToolTip="자료에 대한 간단한 설명을 입력하세요"/>

        <!-- 등록자 / 등록일 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="등록자"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TxtRegBy"/>
            <TextBlock Grid.Column="2" Text="등록일" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecBrush}" Margin="0,0,6,0"
                       HorizontalAlignment="Left"/>
        </Grid>

        <!-- 등록일 (별도 행에 맞추기 위해 오버레이) -->
        <TextBox Grid.Row="2" Grid.Column="1"
                 x:Name="TxtDate"
                 HorizontalAlignment="Right" Width="130"
                 IsReadOnly="True"
                 Foreground="{StaticResource TextDimBrush}"/>

        <!-- CSV 파일 선택 -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="CSV 파일"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <Button Grid.Row="4" Grid.Column="1"
                x:Name="BtnPickFile"
                Content="📂  파일 선택..."
                HorizontalAlignment="Left" Width="160"
                Style="{StaticResource SecondaryButton}"
                Click="BtnPickFile_Click"/>

        <!-- 선택된 파일 경로 -->
        <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource ElevatedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="8,6">
            <TextBlock x:Name="TxtFilePath"
                       Text="선택된 파일이 없습니다."
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="12" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- 확인 / 취소 -->
        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="88" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnOk" Content="등록" Width="88"
                    IsEnabled="False"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
