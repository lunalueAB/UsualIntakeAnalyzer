<Window x:Class="UsualIntakeAnalyzer.Views.ScenarioHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="분석 이력" Height="540" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 헤더 -->
            <RowDefinition Height="Auto"/>   <!-- 검색 -->
            <RowDefinition Height="*"/>       <!-- 테이블 -->
            <RowDefinition Height="Auto"/>   <!-- 버튼 -->
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="분석 이력"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="이전에 등록·실행한 시나리오를 다시 열거나 분석을 재실행할 수 있습니다"
                       FontSize="11" Foreground="{StaticResource TextDimBrush}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 검색 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TxtSearch"
                     TextChanged="TxtSearch_TextChanged"
                     ToolTip="식품군명·등록자 검색"/>
            <TextBlock Grid.Column="1" x:Name="TxtCount"
                       VerticalAlignment="Center" Margin="10,0,0,0"
                       FontSize="12"
                       Foreground="{StaticResource TextSecBrush}"/>
        </Grid>

        <!-- 테이블 -->
        <DataGrid Grid.Row="2" x:Name="GridScenarios"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="Grid_SelectionChanged"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="식품군"
                    Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="식품수"
                    Binding="{Binding FoodCount}" Width="64"/>
                <DataGridTextColumn Header="등록자"
                    Binding="{Binding RegisteredBy}" Width="80"/>
                <DataGridTextColumn Header="등록일"
                    Binding="{Binding RegisteredAt, StringFormat=yyyy-MM-dd}" Width="100"/>
                <DataGridTextColumn Header="마지막 분석"
                    Binding="{Binding LastAnalyzedDisplay}" Width="130"/>
                <DataGridTextColumn Header="캐시"
                    Binding="{Binding CacheBadge}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 버튼 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="BtnDetail" Content="상세 보기"
                        Width="92" Padding="0,7" FontSize="12"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnDetail_Click"
                        IsEnabled="False"/>
                <Button x:Name="BtnDelete" Content="삭제"
                        Width="80" Margin="6,0,0,0" Padding="0,7" FontSize="12"
                        Style="{StaticResource DangerButton}"
                        Click="BtnDelete_Click"
                        IsEnabled="False"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="닫기" Width="92" Padding="0,7" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnClose_Click"/>
                <Button x:Name="BtnOpen" Content="▶ 열기 (분석)"
                        Width="140" Padding="0,7" FontSize="12"
                        Click="BtnOpen_Click"
                        IsEnabled="False"
                        ToolTip="선택한 시나리오를 현재로 지정하고 분석 실행"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
