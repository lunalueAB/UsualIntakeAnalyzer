<Window x:Class="UsualIntakeAnalyzer.Views.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사업 (대분류) 편집" Height="520" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="사업 약어코드 *"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtCode"
                 ToolTip="예: KNHANES, KPNC"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="사업명 (한글) *"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtNameKo"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="사업명 (영문)"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtNameEn"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="수행기관"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtConducting"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="의뢰/위탁기관"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtCommission"/>

        <TextBlock Grid.Row="10" Grid.Column="0" Text="조사 분야"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtDomain"/>

        <TextBlock Grid.Row="12" Grid.Column="0" Text="비고"
                   VerticalAlignment="Top" Margin="0,6,0,0"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="12" Grid.Column="1" x:Name="TxtNote"
                 Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>

        <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="86" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click"/>
            <Button Content="저장" Width="86" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
