<Window x:Class="UsualIntakeAnalyzer.Views.ReassignRoundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자료원 재지정" Height="300" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 제목 -->
            <RowDefinition Height="Auto"/>   <!-- 설명 -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>   <!-- 레이블 -->
            <RowDefinition Height="Auto"/>   <!-- 콤보박스 -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>   <!-- 버튼 -->
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <TextBlock Grid.Row="0"
                   Text="자료원 재지정"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,6"/>

        <!-- 현재 파일 정보 -->
        <Border Grid.Row="1"
                Background="{StaticResource WarningSoftBrush}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="12,8">
            <StackPanel>
                <TextBlock x:Name="TxtFileName"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtCurrentLabel"
                           FontSize="11"
                           Foreground="{StaticResource WarningBrush}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- 새 자료원 레이블 -->
        <TextBlock Grid.Row="3"
                   Text="연결할 새 자료원 (차수) *"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecBrush}"
                   Margin="0,0,0,4"/>

        <!-- 차수 선택 콤보박스 -->
        <ComboBox Grid.Row="4" x:Name="CboRound"
                  SelectionChanged="CboRound_SelectionChanged"/>

        <!-- 버튼 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="취소" Width="86" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnOk" Content="재지정" Width="86"
                    IsEnabled="False"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
