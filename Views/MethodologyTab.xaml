<UserControl x:Class="UsualIntakeAnalyzer.Views.MethodologyTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="40,30,40,30" MaxWidth="1100" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 헤더 -->
                    <RowDefinition Height="Auto"/>   <!-- 인트로 -->
                    <RowDefinition Height="Auto"/>   <!-- 카드 3개 -->
                    <RowDefinition Height="Auto"/>   <!-- 자동 선택 안내 -->
                    <RowDefinition Height="Auto"/>   <!-- 분석하러 가기 -->
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="산출 방법론"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="일상섭취량(usual intake) 추정에 사용되는 통계 방법 소개"
                               FontSize="13" Foreground="{StaticResource TextSecBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 인트로 -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="3,0,0,0"
                        Padding="18,14" CornerRadius="3"
                        Margin="0,0,0,24">
                    <TextBlock TextWrapping="Wrap" LineHeight="22"
                               Foreground="{StaticResource TextBrush}" FontSize="12">
                        <Run FontWeight="SemiBold">일상섭취량(Usual Intake)</Run> 은 1~2일치 식이조사 자료에서
                        개인의 평소(장기 평균) 섭취 분포를 추정하는 개념입니다.
                        <LineBreak/>
                        본 프로그램은 미국 NCI 방법을 기본으로 하며, 자료의 특성에 따라
                        ISU 또는 MSM 방법을 보완 적용합니다.
                    </TextBlock>
                </Border>

                <!-- 카드 3개 -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- NCI -->
                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- badge -->
                                <RowDefinition Height="Auto"/>   <!-- icon -->
                                <RowDefinition Height="Auto"/>   <!-- title -->
                                <RowDefinition Height="Auto"/>   <!-- subtitle -->
                                <RowDefinition Height="*"/>      <!-- description (flex) -->
                                <RowDefinition Height="Auto"/>   <!-- 적용 조건 -->
                                <RowDefinition Height="Auto"/>   <!-- button -->
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource AccentDimBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="기본 방법"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="🎯" FontSize="36"
                                       HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="NCI"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="3" Text="National Cancer Institute Method"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecBrush}"
                                       Margin="0,2,0,12"/>
                            <TextBlock Grid.Row="4" TextWrapping="Wrap" LineHeight="20"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}">
                                미국 국립암연구소가 개발한 표준 방법.
                                섭취 확률(probability)과 섭취량(amount)을
                                <LineBreak/>2단계로 모델링하여 비매일 섭취 식품에도 적용 가능.
                                Box-Cox 변환과 개인 효과를 고려.
                            </TextBlock>
                            <TextBlock Grid.Row="5" FontSize="11" Margin="0,12,0,16"
                                       Foreground="{StaticResource TextDimBrush}">
                                <Run FontWeight="SemiBold">적용:</Run> 본 프로그램의 기본 분석
                            </TextBlock>
                            <Button Grid.Row="6" Content="📖  자세히 보기"
                                    Padding="10,8" FontSize="12"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnNciDetail_Click"/>
                        </Grid>
                    </Border>

                    <!-- ISU -->
                    <Border Grid.Column="2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource SuccessSoftBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="보완 방법 ①"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="📊" FontSize="36"
                                       HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="ISU"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="3" Text="Iowa State University Method"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecBrush}"
                                       Margin="0,2,0,12"/>
                            <TextBlock Grid.Row="4" TextWrapping="Wrap" LineHeight="20"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}">
                                아이오와 주립대 통계연구소(CSAFE)가 개발한
                                <LineBreak/>분포 기반 방법. Box-Cox 변환 후 개인 내·간 분산을
                                분리해 일상섭취량 분포를 추정.
                            </TextBlock>
                            <TextBlock Grid.Row="5" FontSize="11" Margin="0,12,0,16"
                                       Foreground="{StaticResource TextDimBrush}">
                                <Run FontWeight="SemiBold">자동 적용 조건:</Run>
                                papa ≤ 5% AND 0섭취율 ≤ 15%
                            </TextBlock>
                            <Button Grid.Row="6" Content="📖  자세히 보기"
                                    Padding="10,8" FontSize="12"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnIsuDetail_Click"/>
                        </Grid>
                    </Border>

                    <!-- MSM -->
                    <Border Grid.Column="4"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource WarningSoftBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="보완 방법 ②"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="🧮" FontSize="36"
                                       HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="MSM"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="3" Text="Multiple Source Method"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecBrush}"
                                       Margin="0,2,0,12"/>
                            <TextBlock Grid.Row="4" TextWrapping="Wrap" LineHeight="20"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}">
                                독일 연방위해평가원(BfR)·EFSA가 개발한 방법.
                                <LineBreak/>섭취 일수 비율과 섭취량을 별도 모델로 추정해
                                비매일·저빈도 섭취 식품에 적합.
                            </TextBlock>
                            <TextBlock Grid.Row="5" FontSize="11" Margin="0,12,0,16"
                                       Foreground="{StaticResource TextDimBrush}">
                                <Run FontWeight="SemiBold">자동 적용 조건:</Run>
                                papa &gt; 5% OR 0섭취율 &gt; 15%
                            </TextBlock>
                            <Button Grid.Row="6" Content="📖  자세히 보기"
                                    Padding="10,8" FontSize="12"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnMsmDetail_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 자동 선택 안내 -->
                <Border Grid.Row="3"
                        Background="{StaticResource ElevatedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="16,12" Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="ℹ️ 자동 보완 방법 선택 규칙"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" LineHeight="20"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecBrush}">
                            • <Run FontWeight="SemiBold">NCI</Run> 가 항상 기본으로 실행됩니다.
                            <LineBreak/>
                            • <Run FontWeight="SemiBold">papa</Run> (1일만 섭취 비율) ≤ 5%
                            AND <Run FontWeight="SemiBold">0섭취율</Run> ≤ 15% 이면 → ISU 보완
                            <LineBreak/>
                            • <Run FontWeight="SemiBold">papa</Run> &gt; 5%
                            OR <Run FontWeight="SemiBold">0섭취율</Run> &gt; 15% 이면 → MSM 보완
                            <LineBreak/>
                            • 두 방법 결과는 분석 결과 화면의 "📊 방법 비교" 탭에서 NCI와 함께 비교됩니다.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 분석하러 가기 — 그라디언트 CTA 카드 -->
                <Border Grid.Row="4" CornerRadius="8" Padding="24,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1D4ED8 " Offset="0"/>
                            <GradientStop Color="#E0F2FE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="NEXT STEP"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#CBD5E1"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="이제 분석을 시작하세요"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="식품을 선택하고 시나리오를 등록하면 일상섭취량 분포를 확인할 수 있습니다."
                                       FontSize="12"
                                       Foreground="#E0E7FF"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnGoAnalysis"
                                VerticalAlignment="Center"
                                FontSize="14" FontWeight="SemiBold"
                                Padding="22,12"
                                Click="BtnGoAnalysis_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="일상섭취량 분석으로 이동"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="  →"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
