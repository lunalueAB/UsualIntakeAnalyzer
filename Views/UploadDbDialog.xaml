<Window x:Class="UsualIntakeAnalyzer.Views.UploadDbDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DB 업로드" Height="540" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="0,0,0,4">
            <TextBlock Text="DB 업로드"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="종류와 자료원(대분류·기수·차수)을 선택한 뒤 파일을 등록"
                       FontSize="11" Foreground="{StaticResource TextDimBrush}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 종류 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="종류 *"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CboKind"
                  SelectionChanged="CboKind_SelectionChanged">
            <ComboBoxItem Tag="X1" Content="🍱  1일 조사 데이터 (x1, CSV)"/>
            <ComboBoxItem Tag="X0" Content="🍴  2일 조사 데이터 (x0, CSV)"/>
            <ComboBoxItem Tag="CB" Content="📖  코드집 (xlsx)"/>
            <ComboBoxItem Tag="PR" Content="🔬  정밀영양 데이터 (xlsx) — 분석 미지원"/>
        </ComboBox>

        <!-- 대분류 -->
        <TextBlock Grid.Row="4" Grid.Column="0" x:Name="LblProject" Text="대분류 *"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CboProject"
                  SelectionChanged="CboProject_SelectionChanged"/>

        <!-- 기수 -->
        <TextBlock Grid.Row="6" Grid.Column="0" x:Name="LblPhase" Text="기수 *"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <ComboBox Grid.Row="6" Grid.Column="1" x:Name="CboPhase"
                  SelectionChanged="CboPhase_SelectionChanged"/>

        <!-- 차수 -->
        <TextBlock Grid.Row="8" Grid.Column="0" x:Name="LblRound" Text="차수 *"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <ComboBox Grid.Row="8" Grid.Column="1" x:Name="CboRound"/>

        <!-- 코드집 안내 (CB 선택 시 자료원 위치에 표시) -->
        <Border Grid.Row="4" Grid.RowSpan="5" Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="PnlCbInfo" Visibility="Collapsed"
                Background="{StaticResource ElevatedBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="3,0,0,0"
                Padding="14,12" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="코드집은 전역 1개로 운영"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock TextWrapping="Wrap" LineHeight="20"
                           FontSize="12"
                           Foreground="{StaticResource TextSecBrush}"
                           Margin="0,6,0,0">
                    자료원(대분류·기수·차수)과 무관하게 한 개의 코드집만 유지합니다.
                    <LineBreak/>
                    새 코드집을 등록하면 기존 코드집은 자동 삭제됩니다.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 설명 (CSV 전용) -->
        <TextBlock Grid.Row="10" Grid.Column="0" x:Name="LblDesc"
                   Text="설명"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtDesc"/>

        <!-- 등록자 (CSV 전용) -->
        <TextBlock Grid.Row="12" Grid.Column="0" x:Name="LblBy"
                   Text="등록자"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <Grid Grid.Row="12" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TxtRegBy"/>
            <Button Grid.Column="2" Content="📂  파일 선택..."
                    Width="130"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnPickFile_Click"/>
        </Grid>

        <!-- 파일 경로 표시 -->
        <Border Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource ElevatedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="3"
                Padding="10,8" Margin="0,8,0,0"
                VerticalAlignment="Top">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <TextBlock x:Name="TxtFilePath"
                           Text="선택된 파일이 없습니다."
                           FontSize="12"
                           Foreground="{StaticResource TextDimBrush}"
                           TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Border>

        <!-- 버튼 -->
        <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="취소" Width="92" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="등록" Width="92"
                    IsEnabled="False" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
