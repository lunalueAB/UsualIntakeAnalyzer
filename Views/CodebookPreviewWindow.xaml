<Window x:Class="UsualIntakeAnalyzer.Views.CodebookPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="코드집 조회" Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 헤더 -->
            <RowDefinition Height="Auto"/>   <!-- 검색 -->
            <RowDefinition Height="*"/>       <!-- 테이블 -->
            <RowDefinition Height="Auto"/>   <!-- 닫기 -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TxtTitle" Text="코드집"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <TextBlock x:Name="TxtMeta"
                           FontSize="11" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,2,0,0" TextWrapping="NoWrap"/>
            </ScrollViewer>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TxtSearch"
                     TextChanged="TxtSearch_TextChanged"
                     ToolTip="식품명·코드 검색"/>
            <TextBlock Grid.Column="1" x:Name="TxtCount"
                       VerticalAlignment="Center" Margin="10,0,0,0"
                       FontSize="12"
                       Foreground="{StaticResource TextSecBrush}"/>
        </Grid>

        <DataGrid Grid.Row="2" x:Name="GridEntries" RowHeight="44">
            <DataGrid.Columns>
                <DataGridTextColumn Header="1차코드" Binding="{Binding Code}" Width="82"/>
                <DataGridTemplateColumn Header="식품명 / 식품군" Width="*" SortMemberPath="FoodName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FoodName}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding FoodGroup}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecBrush}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="1차코드명" Binding="{Binding CodeName}" Width="160"/>
                <DataGridTextColumn Header="상세분류" Binding="{Binding SubCat1}" Width="80"/>
                <DataGridTextColumn Header="소분류"   Binding="{Binding SubCat2}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="닫기" Width="100" Padding="0,8"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
