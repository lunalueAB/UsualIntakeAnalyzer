<Window x:Class="UsualIntakeAnalyzer.Views.FoodPresetEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="산출식품 편집" Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 명칭 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="명칭 *"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtName"
                 ToolTip="예: 과일류 전체, 아침식용 곡류"/>

        <!-- 설명 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="설명"
                   VerticalAlignment="Top" Margin="0,6,0,0"
                   Foreground="{StaticResource TextSecBrush}"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtDesc"
                 Height="48" TextWrapping="Wrap" AcceptsReturn="True"/>

        <!-- 식품 목록 헤더 -->
        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="포함 식품 (저장 당시 식품명)"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="TxtCount" Text=""
                           FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="선택 항목 제거"
                    Padding="10,4" FontSize="11"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnRemove_Click"/>
        </Grid>

        <!-- 식품 목록 -->
        <DataGrid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                  x:Name="GridFoods"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="식품명" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="대표 코드" Binding="{Binding Code}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 코드 표시 -->
        <ScrollViewer Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="56" Margin="0,8,0,0">
            <TextBlock x:Name="TxtCodes"
                       FontSize="10" Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap"/>
        </ScrollViewer>

        <!-- 버튼 -->
        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="86" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click"/>
            <Button Content="저장" Width="86" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
