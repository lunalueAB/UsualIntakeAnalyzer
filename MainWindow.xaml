<Window x:Class="UsualIntakeAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UsualIntakeAnalyzer.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="일상섭취량 분석 프로그램"
        Height="880" Width="1500" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════ -->
            <!-- Title bar (Win11 style)                                    -->
            <!-- ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgTitlebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App icon + title (draggable area) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Width="18" Height="18" CornerRadius="3"
                                Background="{StaticResource AccentBrush}">
                            <TextBlock Text="일" FontSize="10" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="일상섭취량 분석 프로그램  —  식품안전 위해평가 도구"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource TextSecBrush}"/>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowChromeButton}"
                                Click="BtnMinimize_Click" ToolTip="최소화">
                            <Path Data="M 0,5 L 10,5"
                                  Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1.2" Width="10" Height="10"
                                  Stretch="None" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource WindowChromeButton}"
                                Click="BtnMaximize_Click" ToolTip="최대화">
                            <Rectangle Width="10" Height="10"
                                       Stroke="{StaticResource TextBrush}"
                                       StrokeThickness="1.2" Fill="Transparent"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}"
                                Click="BtnClose_Click" ToolTip="닫기">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1.2" Width="10" Height="10"
                                  Stretch="None" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════ -->
            <!-- Main area: sidebar + content                               -->
            <!-- ════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Sidebar ─────────────────────────────────────── -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgSidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Brand header -->
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,18,16,14">
                            <StackPanel>
                                <TextBlock Text="FOOD INTAKE"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="일상섭취량 분석"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="v2.4.1"
                                           FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Nav -->
                        <StackPanel Grid.Row="1" Margin="8,8">
                            <TextBlock Text="WORKSPACE"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Margin="10,6,10,6"/>

                            <ToggleButton x:Name="NavMethod"
                                          Style="{StaticResource SidebarNavButton}"
                                          IsChecked="True"
                                          Click="NavToggle_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" x:Name="NavMethodIcon"
                                            Width="28" Height="28" CornerRadius="4"
                                            Background="{StaticResource AccentBrush}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="📘" FontSize="13"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="산출 방법론"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="통계 방법 비교·선택"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ToggleButton>

                            <ToggleButton x:Name="NavAnalysis"
                                          Style="{StaticResource SidebarNavButton}"
                                          Click="NavToggle_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" x:Name="NavAnalysisIcon"
                                            Width="28" Height="28" CornerRadius="4"
                                            Background="{StaticResource BgHoverBrush}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="📊" FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="일상섭취량 분석"
                                                   FontWeight="Medium" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="시나리오 등록 및 결과"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ToggleButton>

                            <ToggleButton x:Name="NavDb"
                                          Style="{StaticResource SidebarNavButton}"
                                          Click="NavToggle_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" x:Name="NavDbIcon"
                                            Width="28" Height="28" CornerRadius="4"
                                            Background="{StaticResource BgHoverBrush}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="🗄" FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="DB 조회 / 관리"
                                                   FontWeight="Medium" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="식품 데이터 관리"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Content (UserControl 3개를 겹쳐 두고 가시성 토글) ── -->
                <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
                    <views:MethodologyTab x:Name="MethodTabCtrl" Loaded="MethodTabCtrl_Loaded"/>
                    <views:AnalysisTab    x:Name="AnalysisTabCtrl"  Visibility="Collapsed"/>
                    <views:DbManagementTab x:Name="DbTabCtrl"        Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <!-- ════════════════════════════════════════════════════════ -->
            <!-- Status bar                                                 -->
            <!-- ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgTitlebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7"
                                 Fill="{StaticResource SuccessBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatusDb"
                                   Text="DB 연결됨" Margin="6,0,18,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatusContext"
                                   Text="" Margin="0,0,18,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="v2.4.1" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Margin="0,0,18,0"/>
                        <TextBlock Text="UTF-8" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Margin="0,0,18,0"/>
                        <TextBlock x:Name="TxtStatusRam"
                                   Text="RAM —" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
